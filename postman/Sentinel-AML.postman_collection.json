{
  "info": {
    "name": "Sentinel AML",
    "description": "Ingestion -> detection -> alert -> case disposition flow for the Sentinel AML hackathon MVP. Seed data: customers.csv/accounts.csv as provided (2 customers, 2 accounts, both under CUST_00001); transactions.csv is authored to trip all 3 typologies on those two accounts.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080", "type": "string" },
    { "key": "alertId", "value": "1", "type": "string" },
    { "key": "dispositionedAlertId", "value": "1", "type": "string" },
    { "key": "mergeTargetAlertId", "value": "2", "type": "string" }
  ],
  "item": [
    {
      "name": "Alerts",
      "item": [
        {
          "name": "List alerts (sorted by risk score desc)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/alerts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "alerts"]
            },
            "description": "Analyst queue. Expect 3 alerts on a fresh seed: HIGH_RISK_JURISDICTION (95), STRUCTURING (85), LARGE_TRANSACTION (75), all for CUST_00001. Run this first and update the alertId/dispositionedAlertId/mergeTargetAlertId collection variables to match the actual IDs returned -- creation order (and therefore ID assignment) isn't a documented guarantee."
          }
        },
        {
          "name": "Get alert detail",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/alerts/{{alertId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "alerts", "{{alertId}}"]
            },
            "description": "Full detail: triggeredRuleType, riskScore, explanation, evidenceTransactionIds."
          }
        },
        {
          "name": "Disposition the structuring alert",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dispositionStatus\": \"CLEARED_FALSE_POSITIVE\",\n  \"dispositionReason\": \"KYC confirmed legitimate source of funds.\",\n  \"analystId\": \"analyst.rao\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/alerts/{{dispositionedAlertId}}/disposition",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "alerts", "{{dispositionedAlertId}}", "disposition"]
            },
            "description": "dispositionedAlertId should point at the STRUCTURING alert (set it from the List call above). dispositionStatus: CLEARED_FALSE_POSITIVE | ESCALATED_TO_FIU | CONFIRMED_SUSPICIOUS. Alert is never deleted; status flips to DISPOSITIONED and a Case row is written."
          }
        },
        {
          "name": "Confirm alert still exists after disposition",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/alerts/{{dispositionedAlertId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "alerts", "{{dispositionedAlertId}}"]
            },
            "description": "status should now be DISPOSITIONED, not gone."
          }
        }
      ]
    },
    {
      "name": "Ingestion",
      "item": [
        {
          "name": "Ingest single transaction (streaming-style, dedup merge)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "[\n  {\n    \"accountId\": \"ACC_000001\",\n    \"amount\": 500.00,\n    \"currencyCode\": \"INR\",\n    \"counterpartyCountryCode\": \"IR\",\n    \"channel\": \"WIRE_TRANSFER\",\n    \"transactionTimestamp\": \"2026-09-19T08:00:00Z\"\n  }\n]"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/ingest/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "ingest", "transactions"]
            },
            "description": "A new IR transaction on ACC_000001 (CUST_00001). Should merge into the existing HIGH_RISK_JURISDICTION alert (its evidence already has one KP transaction from seed) instead of creating a duplicate -- alert count stays at 3, evidence grows to 2 transaction IDs."
          }
        },
        {
          "name": "Confirm evidence merged (no duplicate alert)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/alerts/{{mergeTargetAlertId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "alerts", "{{mergeTargetAlertId}}"]
            },
            "description": "mergeTargetAlertId should point at the HIGH_RISK_JURISDICTION alert. evidenceTransactionIds should now contain both the seed KP transaction and the new IR transaction."
          }
        },
        {
          "name": "Ingest batch (more structuring evidence, still merges)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "[\n  {\"accountId\":\"ACC_000001\",\"amount\":9100.00,\"currencyCode\":\"INR\",\"counterpartyCountryCode\":\"IN\",\"channel\":\"ONLINE\",\"transactionTimestamp\":\"2026-09-20T09:00:00Z\"},\n  {\"accountId\":\"ACC_000001\",\"amount\":9400.00,\"currencyCode\":\"INR\",\"counterpartyCountryCode\":\"IN\",\"channel\":\"ONLINE\",\"transactionTimestamp\":\"2026-09-20T15:00:00Z\"},\n  {\"accountId\":\"ACC_000001\",\"amount\":9900.00,\"currencyCode\":\"INR\",\"counterpartyCountryCode\":\"IN\",\"channel\":\"ONLINE\",\"transactionTimestamp\":\"2026-09-21T06:00:00Z\"}\n]"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/ingest/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "ingest", "transactions"]
            },
            "description": "3 more transactions in the $9,000-$9,999 structuring band, this time on ACC_000001. Dedup is keyed by customer+ruleType (not per-account), and CUST_00001 already has an OPEN STRUCTURING alert from seed data, so this MERGES into it -- alert count stays at 3, but that alert's evidence grows from 3 to 6 transaction IDs. Run 'Ingest single transaction (streaming-style, dedup merge)' from the Alerts folder's disposition step first if you want to see a genuinely NEW 4th alert instead: dispositioning the STRUCTURING alert closes it, so this same batch would then create a fresh alert rather than merge (see the README's 'Known limitation' section)."
          }
        },
        {
          "name": "Confirm alert count after merge",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/alerts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "alerts"]
            },
            "description": "Expect still 3 alerts total (merge, not a new alert) unless you dispositioned the STRUCTURING alert first, in which case expect 4."
          }
        }
      ]
    },
    {
      "name": "Error cases",
      "item": [
        {
          "name": "Get unknown alert -> 404",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/alerts/999",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "alerts", "999"]
            }
          }
        },
        {
          "name": "Disposition with missing required field -> 400",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dispositionStatus\": \"CLEARED_FALSE_POSITIVE\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/alerts/{{alertId}}/disposition",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "alerts", "{{alertId}}", "disposition"]
            },
            "description": "Missing dispositionReason/analystId -> 400 with a consistent ApiErrorResponse body."
          }
        },
        {
          "name": "Ingest transaction for unknown account -> 404, nothing persisted",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "[\n  {\n    \"accountId\": \"ACC_DOES_NOT_EXIST\",\n    \"amount\": 100,\n    \"currencyCode\": \"INR\",\n    \"counterpartyCountryCode\": \"IN\",\n    \"channel\": \"ONLINE\",\n    \"transactionTimestamp\": \"2026-09-19T08:00:00Z\"\n  }\n]"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/ingest/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "ingest", "transactions"]
            }
          }
        }
      ]
    }
  ]
}
